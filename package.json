{
  "name": "jee-examination-portal",
  "version": "1.0.0",
  "description": "A comprehensive online examination system for competitive exams like JEE",
  "keywords": ["examination", "jee", "nestjs", "react", "microservices"],
  "author": "JEE Portal Team",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "services/*",
    "frontend/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:down": "docker-compose down",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "setup:dev": "./scripts/setup-dev.sh",
    "seed:data": "npm run seed:data --workspace=scripts",
    "k6:load-test": "k6 run tests/load/exam-load-test.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/jee-examination-portal.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/jee-examination-portal/issues"
  },
  "homepage": "https://github.com/your-org/jee-examination-portal#readme"
}